<?xml version="1.0" encoding="utf-8"?>
<!-- Answer option card: highlighted in brand blue when the RadioButton is checked. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_blue_soft" />
            <stroke android:width="2dp" android:color="@color/brand_blue" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#F3F6FF" />
            <stroke android:width="1.5dp" android:color="#C9D3F5" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke android:width="1.5dp" android:color="@color/outline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
