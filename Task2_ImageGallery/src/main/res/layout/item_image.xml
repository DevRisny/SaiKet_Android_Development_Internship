<?xml version="1.0" encoding="utf-8"?>
<!-- One GridView cell: a rounded square picture with its title. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false"
    app:cardCornerRadius="22dp"
    app:strokeWidth="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.risnysuha.saiket.gallery.SquareImageView
            android:id="@+id/item_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim" />

        <TextView
            android:id="@+id/item_number"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="10dp"
            android:background="@drawable/bg_number"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="@color/brand_blue_dark"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
